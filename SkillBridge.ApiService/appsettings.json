{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SkillBridgeDb": "Host=REPLACE_WITH_YOUR_NEON_HOST;Database=skillbridge;Username=REPLACE_ME;Password=REPLACE_ME;SSL Mode=Require"
  },
  "Jwt": {
    "Key": "dev-only-signing-key-replace-before-any-real-deployment-1234567890",
    "Issuer": "SkillBridge.ApiService",
    "Audience": "SkillBridge",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenDaysRemembered": 30
  }
}
