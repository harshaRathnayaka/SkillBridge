{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SkillBridgeDb": "DataSource=skillbridge.db"
  },
  "Jwt": {
    "Key": "dev-only-signing-key-replace-before-any-real-deployment-1234567890",
    "Issuer": "SkillBridge.ApiService",
    "Audience": "SkillBridge",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenDaysRemembered": 30
  }
}
