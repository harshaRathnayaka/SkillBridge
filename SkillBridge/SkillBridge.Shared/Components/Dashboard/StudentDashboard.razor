@inject IMarketplaceApiClient MarketplaceApiClient

<div class="stat-tile-grid">
    <StatTile Label="Active courses" Value="@Data.ActiveCourses.ToString()" SubLabel="@($"{Data.LessonsRemainingTotal} lessons remaining")" />
    <StatTile Label="Teachers" Value="@Data.DistinctTeachers.ToString()" SubLabel="@($"across {Data.DistinctTeachers} subjects")" />
    <StatTile Label="Hours this month" Value="@(Data.HoursThisMonth?.ToString() ?? "—")" />
    <StatTile Label="Avg. progress" Value="@($"{Data.AvgProgressPercent}%")" SubLabel="keep going" />
</div>

<div class="dashboard-columns">
    <div class="dashboard-main">
        @foreach (var course in Data.Courses)
        {
            <div class="dashboard-card">
                <div class="dashboard-card-head">
                    <div>
                        <div class="dashboard-card-title">@course.Title</div>
                        <div class="text-muted small">with @course.TeacherName</div>
                    </div>
                    <span class="dashboard-badge">@course.LessonsRemaining lessons left</span>
                </div>
                <ProgressBar Percent="course.ProgressPercent" />
                <div class="dashboard-card-foot">
                    <span class="text-muted small">Next: @course.NextLessonTitle</span>
                </div>
            </div>
        }
        @if (Data.Courses.Count == 0)
        {
            <p class="text-muted small">No active courses yet.</p>
        }
    </div>
    <div class="dashboard-side">
        <div class="dashboard-card">
            <h3 class="dashboard-card-heading">Upcoming sessions</h3>
            @foreach (var session in Data.UpcomingSessions)
            {
                <div class="dashboard-list-item">
                    <div class="text-muted small">@session.At.ToLocalTime().ToString("ddd · HH:mm")</div>
                    <div>@session.Title</div>
                    <div class="text-muted small">@session.WithName</div>
                </div>
            }
        </div>
        <div class="dashboard-card">
            <h3 class="dashboard-card-heading">Suggested teachers</h3>
            @if (errorMessage is not null)
            {
                <div class="alert alert-danger py-1 px-2 small mb-2">@errorMessage</div>
            }
            @foreach (var teacher in Data.SuggestedTeachers)
            {
                <div class="dashboard-list-item">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <div>@teacher.Name</div>
                            <div class="text-muted small">@teacher.Subject · @teacher.RateLabel</div>
                        </div>
                        <button class="btn btn-sm btn-primary" disabled="@(busyCourseId == teacher.CourseId)"
                                @onclick="() => EnrollAsync(teacher.CourseId)">
                            @(busyCourseId == teacher.CourseId ? "Enrolling…" : "Enroll")
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public StudentDashboardInfo Data { get; set; } = null!;

    [Parameter, EditorRequired]
    public string AccessToken { get; set; } = "";

    [Parameter, EditorRequired]
    public EventCallback OnChanged { get; set; }

    private Guid? busyCourseId;
    private string? errorMessage;

    private async Task EnrollAsync(Guid courseId)
    {
        busyCourseId = courseId;
        errorMessage = null;

        var result = await MarketplaceApiClient.EnrollAsync(AccessToken, courseId);
        if (!result.Succeeded)
        {
            errorMessage = result.Errors.FirstOrDefault() ?? "Couldn't enroll. Please try again.";
            busyCourseId = null;
            return;
        }

        busyCourseId = null;
        await OnChanged.InvokeAsync();
    }
}
