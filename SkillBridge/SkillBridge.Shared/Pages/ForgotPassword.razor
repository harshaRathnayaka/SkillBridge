@page "/forgot-password"
@layout EmptyLayout
@inject IAuthApiClient AuthApiClient
@inject NavigationManager Navigation

<PageTitle>Reset your password</PageTitle>

<div class="auth-shell">
    <AuthPromoPanel />

    <div class="auth-form-panel">
        <div class="auth-topbar">
            <a href="/login" class="fw-semibold">Back to sign in</a>
        </div>

        <div class="auth-form-wrap">
            @if (submitted)
            {
                <div class="auth-eyebrow" style="color: var(--sb-primary);">Check your email</div>
                <h2>We've sent a reset code</h2>
                <p class="text-muted small mb-4">If an account exists for <strong>@model.Email</strong>, a password reset code is on its way.</p>
                <a class="btn btn-primary w-100" href="/reset-password">Enter reset code</a>
            }
            else
            {
                <div class="auth-eyebrow" style="color: var(--sb-primary);">Forgot password</div>
                <h2>Reset your password</h2>
                <p class="text-muted small mb-4">Enter your email and we'll send you a code to reset your password.</p>

                <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <InputText class="form-control" @bind-Value="model.Email" placeholder="you@example.com" />
                        <ValidationMessage For="() => model.Email" />
                    </div>

                    <button class="btn btn-primary w-100" type="submit" disabled="@isSubmitting">
                        @(isSubmitting ? "Sending..." : "Send reset code")
                    </button>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private readonly ForgotPasswordRequest model = new();
    private bool isSubmitting;
    private bool submitted;

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        await AuthApiClient.ForgotPasswordAsync(model.Email);
        // Always shows the same "check your email" message, matching the API's response,
        // which never reveals whether the email was actually registered.
        isSubmitting = false;
        submitted = true;
    }
}
