@page "/find-work"
@inject IMarketplaceApiClient MarketplaceApiClient
@inject IAuthTokenStore TokenStore

<PageTitle>Find work</PageTitle>

<RoleGuard Role="JobSeeker">
    <div class="home-hero">
        <h1>Find your next role</h1>
        <p class="text-muted">Browse open roles and apply when one matches what you're looking for.</p>
    </div>

    <div class="filter-chip-row my-3">
        @foreach (var mode in WorkModes)
        {
            <button class="filter-chip @(selectedWorkMode == mode ? "active" : "")" @onclick="() => SelectWorkMode(mode)">
                @(mode ?? "All roles")
            </button>
        }
    </div>

    @if (loading)
    {
        <p class="text-muted small">Loading roles…</p>
    }
    else
    {
        @if (errorMessage is not null)
        {
            <div class="alert alert-danger py-1 px-2 small mb-2">@errorMessage</div>
        }
        <p class="text-muted small">@FilteredJobs.Count role@(FilteredJobs.Count == 1 ? "" : "s") available</p>
        @foreach (var job in FilteredJobs)
        {
            <div class="dashboard-card mb-3">
                <div class="dashboard-card-head">
                    <div>
                        <div class="dashboard-card-title">@job.Title</div>
                        <div class="text-muted small">@job.CompanyDisplayName · @job.Location · @job.WorkMode</div>
                    </div>
                    <span class="dashboard-badge">@job.PostedLabel</span>
                </div>
                <div class="dashboard-card-foot">
                    <span class="text-muted small">@job.EmploymentType · @job.RateLabel · @job.ApplicantCount applicant@(job.ApplicantCount == 1 ? "" : "s")</span>
                    @if (job.IsApplied)
                    {
                        <span class="dashboard-badge">Applied</span>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-primary" disabled="@(busyJobPostingId == job.Id)"
                                @onclick="() => ApplyAsync(job.Id)">
                            @(busyJobPostingId == job.Id ? "Applying…" : "Apply")
                        </button>
                    }
                </div>
            </div>
        }
        @if (FilteredJobs.Count == 0)
        {
            <p class="text-muted small">No roles match this filter right now.</p>
        }
    }
</RoleGuard>

@code {
    private static readonly string?[] WorkModes = [null, "Remote", "Hybrid", "On-site"];

    private IReadOnlyList<JobCatalogItemInfo> jobs = [];
    private string? selectedWorkMode;
    private bool loading = true;
    private string? accessToken;
    private Guid? busyJobPostingId;
    private string? errorMessage;

    private List<JobCatalogItemInfo> FilteredJobs =>
        (selectedWorkMode is null
            ? jobs
            : jobs.Where(j => string.Equals(j.WorkMode, selectedWorkMode, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void SelectWorkMode(string? mode) => selectedWorkMode = mode;

    private async Task LoadAsync()
    {
        accessToken = await TokenStore.GetAccessTokenAsync();
        if (accessToken is not null)
        {
            jobs = await MarketplaceApiClient.GetJobCatalogAsync(accessToken);
        }

        loading = false;
    }

    private async Task ApplyAsync(Guid jobPostingId)
    {
        if (accessToken is null)
        {
            return;
        }

        busyJobPostingId = jobPostingId;
        errorMessage = null;

        var result = await MarketplaceApiClient.ApplyAsync(accessToken, jobPostingId);
        busyJobPostingId = null;
        if (!result.Succeeded)
        {
            errorMessage = result.Errors.FirstOrDefault() ?? "Couldn't apply. Please try again.";
            return;
        }

        await LoadAsync();
    }
}
