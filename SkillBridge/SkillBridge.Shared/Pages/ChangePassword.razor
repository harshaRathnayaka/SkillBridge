@page "/change-password"
@inject IAuthApiClient AuthApiClient
@inject IAuthTokenStore TokenStore

<PageTitle>Change password</PageTitle>

<AuthorizeView>
    <Authorized Context="authContext">
        <h1>Change password</h1>

        @if (succeeded)
        {
            <div class="alert alert-success">Your password has been changed.</div>
        }

        <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" class="col-12 col-md-6">
            <DataAnnotationsValidator />
            <ValidationSummary />
            @if (errorMessage is not null)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="mb-3">
                <label class="form-label">Current password</label>
                <InputText type="password" class="form-control" @bind-Value="model.CurrentPassword" />
                <ValidationMessage For="() => model.CurrentPassword" />
            </div>

            <div class="mb-3">
                <label class="form-label">New password</label>
                <InputText type="password" class="form-control" @bind-Value="model.NewPassword" />
                <ValidationMessage For="() => model.NewPassword" />
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm new password</label>
                <InputText type="password" class="form-control" @bind-Value="model.ConfirmPassword" />
                <ValidationMessage For="() => model.ConfirmPassword" />
            </div>

            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Changing..." : "Change password")
            </button>
        </EditForm>
    </Authorized>
    <NotAuthorized>
        <p><a href="/login">Sign in</a> to change your password.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly ChangePasswordRequest model = new();
    private string? errorMessage;
    private bool isSubmitting;
    private bool succeeded;

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        errorMessage = null;
        succeeded = false;

        var tokens = await TokenStore.GetTokensAsync();
        if (tokens is null)
        {
            errorMessage = "You're not signed in.";
            isSubmitting = false;
            return;
        }

        var result = await AuthApiClient.ChangePasswordAsync(tokens.AccessToken, model.CurrentPassword, model.NewPassword);

        if (!result.Succeeded)
        {
            errorMessage = result.Errors.FirstOrDefault() ?? "Could not change your password. Please try again.";
            isSubmitting = false;
            return;
        }

        succeeded = true;
        isSubmitting = false;
        model.CurrentPassword = string.Empty;
        model.NewPassword = string.Empty;
        model.ConfirmPassword = string.Empty;
    }
}
