@page "/post-pipeline"
@inject IDashboardApiClient DashboardApiClient
@inject IMarketplaceApiClient MarketplaceApiClient
@inject IAuthTokenStore TokenStore

<PageTitle>Post & pipeline</PageTitle>

<RoleGuard Role="JobGiver">
    <div class="home-hero">
        <h1>Post &amp; pipeline</h1>
        <p class="text-muted">Track candidates through every stage and manage your open roles.</p>
    </div>

    <div class="studio-tabs my-3">
        <button class="studio-tab @(activeTab == PipelineTab.Pipeline ? "active" : "")" @onclick="() => activeTab = PipelineTab.Pipeline">Pipeline</button>
        <button class="studio-tab @(activeTab == PipelineTab.PostJob ? "active" : "")" @onclick="() => activeTab = PipelineTab.PostJob">Post a job</button>
        <button class="studio-tab @(activeTab == PipelineTab.Listings ? "active" : "")" @onclick="() => SelectListingsTab()">My listings</button>
    </div>

    @if (loading)
    {
        <p class="text-muted small">Loading…</p>
    }
    else if (employer is null)
    {
        <p class="text-muted small">Couldn't load your pipeline right now.</p>
    }
    else if (activeTab == PipelineTab.Pipeline)
    {
        @if (candidateErrorMessage is not null)
        {
            <div class="alert alert-danger py-1 px-2 small mb-2">@candidateErrorMessage</div>
        }
        <div class="kanban-board">
            @foreach (var stage in Stages)
            {
                var stageCandidates = employer.Candidates.Where(c => c.Stage == stage).ToList();
                <div class="kanban-column">
                    <h3 class="dashboard-card-heading">@stage <span class="dashboard-badge">@stageCandidates.Count</span></h3>
                    @foreach (var candidate in stageCandidates)
                    {
                        <div class="dashboard-card mb-2">
                            <div class="dashboard-card-title">@candidate.Name</div>
                            <div class="text-muted small">@candidate.Headline</div>
                            <div class="dashboard-card-foot">
                                <span class="text-muted small">@candidate.RateLabel</span>
                                @if (candidate.Stage != "Offer")
                                {
                                    <button class="btn btn-sm btn-outline-primary" disabled="@(busyApplicationId == candidate.ApplicationId)"
                                            @onclick="() => AdvanceAsync(candidate.ApplicationId)">
                                        @(busyApplicationId == candidate.ApplicationId ? "Advancing…" : "Advance")
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    @if (stageCandidates.Count == 0)
                    {
                        <p class="text-muted small">Nobody here yet.</p>
                    }
                </div>
            }
        </div>
    }
    else if (activeTab == PipelineTab.PostJob)
    {
        <div class="dashboard-card" style="max-width: 480px;">
            @if (postingErrorMessage is not null)
            {
                <div class="alert alert-danger py-1 px-2 small mb-2">@postingErrorMessage</div>
            }
            <div class="mb-2">
                <label class="form-label small mb-1">Title</label>
                <input class="form-control form-control-sm" @bind="newTitle" placeholder="e.g. Senior Maths Tutor" />
            </div>
            <div class="mb-2">
                <label class="form-label small mb-1">Location</label>
                <input class="form-control form-control-sm" @bind="newLocation" placeholder="e.g. Colombo, LK" />
            </div>
            <div class="row g-2 mb-2">
                <div class="col">
                    <label class="form-label small mb-1">Work mode</label>
                    <input class="form-control form-control-sm" @bind="newWorkMode" placeholder="Remote / Hybrid" />
                </div>
                <div class="col">
                    <label class="form-label small mb-1">Type</label>
                    <input class="form-control form-control-sm" @bind="newEmploymentType" placeholder="Part-time" />
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small mb-1">Rate</label>
                <input class="form-control form-control-sm" @bind="newRateLabel" placeholder="e.g. LKR 3,500 / hr" />
            </div>
            <button class="btn btn-sm btn-primary" disabled="@creatingPosting" @onclick="CreatePostingAsync">
                @(creatingPosting ? "Posting…" : "Post job")
            </button>
        </div>
    }
    else
    {
        @if (listingsErrorMessage is not null)
        {
            <div class="alert alert-danger py-1 px-2 small mb-2">@listingsErrorMessage</div>
        }
        @foreach (var listing in listings)
        {
            <div class="dashboard-card mb-3">
                <div class="dashboard-card-head">
                    <div>
                        <div class="dashboard-card-title">@listing.Title</div>
                        <div class="text-muted small">@listing.EmploymentType · @listing.WorkMode · posted @listing.PostedLabel</div>
                    </div>
                    <span class="dashboard-badge">@listing.ApplicantCount applicant@(listing.ApplicantCount == 1 ? "" : "s")</span>
                </div>
            </div>
        }
        @if (listings.Count == 0)
        {
            <p class="text-muted small">No listings posted yet.</p>
        }
    }
</RoleGuard>

@code {
    private enum PipelineTab { Pipeline, PostJob, Listings }

    private static readonly string[] Stages = ["New", "Screening", "Interview", "Offer"];

    private PipelineTab activeTab = PipelineTab.Pipeline;
    private EmployerDashboardInfo? employer;
    private List<EmployerJobListingItemInfo> listings = [];
    private bool loading = true;
    private bool listingsLoaded;
    private string? accessToken;

    private Guid? busyApplicationId;
    private string? candidateErrorMessage;
    private string? listingsErrorMessage;

    private bool creatingPosting;
    private string newTitle = "";
    private string newLocation = "";
    private string newWorkMode = "";
    private string newEmploymentType = "";
    private string newRateLabel = "";
    private string? postingErrorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        accessToken = await TokenStore.GetAccessTokenAsync();
        if (accessToken is not null)
        {
            var dashboard = await DashboardApiClient.GetDashboardAsync(accessToken);
            employer = dashboard?.Employer;
        }

        loading = false;
    }

    private async Task SelectListingsTab()
    {
        activeTab = PipelineTab.Listings;
        if (listingsLoaded || accessToken is null)
        {
            return;
        }

        listingsErrorMessage = null;
        listings = (await MarketplaceApiClient.GetMyJobPostingsAsync(accessToken)).ToList();
        listingsLoaded = true;
    }

    private async Task AdvanceAsync(Guid applicationId)
    {
        candidateErrorMessage = null;
        busyApplicationId = applicationId;

        var result = await MarketplaceApiClient.AdvanceApplicationAsync(accessToken!, applicationId);

        busyApplicationId = null;
        if (!result.Succeeded)
        {
            candidateErrorMessage = result.Errors.FirstOrDefault() ?? "Couldn't advance the candidate. Please try again.";
            return;
        }

        await LoadAsync();
    }

    private async Task CreatePostingAsync()
    {
        postingErrorMessage = null;
        if (string.IsNullOrWhiteSpace(newTitle))
        {
            postingErrorMessage = "Title is required.";
            return;
        }

        creatingPosting = true;
        var result = await MarketplaceApiClient.CreateJobPostingAsync(
            accessToken!, newTitle, newLocation, newWorkMode, newEmploymentType, newRateLabel);

        creatingPosting = false;
        if (!result.Succeeded)
        {
            postingErrorMessage = result.Errors.FirstOrDefault() ?? "Couldn't post the job. Please try again.";
            return;
        }

        newTitle = newLocation = newWorkMode = newEmploymentType = newRateLabel = "";
        listingsLoaded = false;
        await LoadAsync();
        activeTab = PipelineTab.Pipeline;
    }
}
